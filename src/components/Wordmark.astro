---
import { SITE } from '@/site';

interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---
<a class="wordmark" href="/" aria-label={`${SITE.name} — home`}>
  <span class="wm-mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="100%" height="100%" fill="none">
      <rect x="1" y="1" width="30" height="30" rx="15" stroke="currentColor" stroke-width="1.3" opacity="0.5" />
      <path
        d="M16 5 V27 M9 12 Q16 9 23 12 M9 20 Q16 23 23 20"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
        opacity="0.85"
      />
    </svg>
  </span>
  <span class="wm-text">
    <span class="wm-name">{SITE.name}</span>
    {!small && <span class="wm-sub">{SITE.wordmarkSub}</span>}
  </span>
</a>
