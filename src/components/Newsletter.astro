---
import Icon from './Icon.astro';

interface Props {
  variant?: 'band';
}
const { variant = 'band' } = Astro.props;
---
<section class={`news news-${variant}`} aria-labelledby="news-h" data-newsletter>
  <div class="wrap news-grid">
    <div class="news-copy">
      <p class="eyebrow accent">The Drift Letter</p>
      <h2 id="news-h" class="display news-title">Notes on building AI that keeps people in command.</h2>
      <p class="news-sub">
        An occasional letter — new essays, what I am learning across the ventures, and the
        thinking behind <em>Slow Intelligence</em>. No cadence promises, no noise.
      </p>
    </div>
    <div class="news-form-wrap">
      <div class="news-done" data-news-done hidden>
        <Icon name="feather" size={20} />
        <div>
          <strong>You are on the list.</strong>
          <span>Look out for a confirmation in your inbox — <span data-news-email>your email</span>.</span>
        </div>
      </div>
      <form class="news-form" data-news-form novalidate>
        <label class="meta" for="news-email">Email address</label>
        <div class="news-row">
          <input
            id="news-email"
            name="email"
            type="email"
            required
            placeholder="you@company.com"
            autocomplete="email"
          />
          <button class="btn btn-primary" type="submit" data-news-submit>
            Subscribe<Icon name="arrowRight" size={15} cls="arrow" />
          </button>
        </div>
        {/* Honeypot — hidden from people, tempting to bots. Real users leave it empty. */}
        <div class="news-hp" aria-hidden="true">
          <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="meta news-error" data-news-error hidden></p>
        <p class="meta news-fine">A few times a year. Unsubscribe in one click.</p>
      </form>
    </div>
  </div>
</section>

<script>
  // Newsletter signup → posts to the Worker's /api/subscribe route, which forwards
  // the email to MailerLite server-side (token stays on the server). See
  // worker/index.js. Locally (`astro dev`) the /api route doesn't exist, so submit
  // will report an error — test against the deployed site or `wrangler dev`.
  document.querySelectorAll<HTMLElement>('[data-newsletter]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-news-form]');
    const done = root.querySelector<HTMLElement>('[data-news-done]');
    const emailOut = root.querySelector<HTMLElement>('[data-news-email]');
    const errEl = root.querySelector<HTMLElement>('[data-news-error]');
    const input = root.querySelector<HTMLInputElement>('input[type="email"]');
    const hp = root.querySelector<HTMLInputElement>('input[name="company"]');
    const btn = root.querySelector<HTMLButtonElement>('[data-news-submit]');

    const showError = (msg: string) => {
      if (errEl) {
        errEl.textContent = msg;
        errEl.hidden = false;
      }
      if (btn) btn.disabled = false;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input?.value.trim() ?? '';
      if (errEl) errEl.hidden = true;

      if (!email || !input?.checkValidity()) {
        showError('Please enter a valid email address.');
        return;
      }
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, company: hp?.value ?? '' }),
        });
        const data = await res.json().catch(() => ({ ok: false }));

        if (res.ok && data.ok) {
          if (emailOut) emailOut.textContent = email;
          if (form) form.hidden = true;
          if (done) done.hidden = false;
          return;
        }

        showError(
          data.error === 'invalid-email'
            ? 'That email doesn’t look right — please check it.'
            : 'Something went wrong. Please try again in a moment.',
        );
      } catch {
        showError('Network error — please try again.');
      }
    });
  });
</script>
