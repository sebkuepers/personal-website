{
  // Cloudflare Worker: serves the static Astro site (ASSETS binding) and one
  // server route — POST /api/subscribe — which forwards an email to MailerLite
  // using a server-side token (see worker/index.js).
  //
  // The Worker runs first on every request (run_worker_first) so it can 301 the
  // alias domains (.de, www) to the canonical .com; everything else is handed
  // straight to the ASSETS binding, so _headers and the 404 page still apply.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  // Non-secret runtime vars live here so they survive every CI deploy.
  // (Dashboard plain-text vars get wiped by `wrangler deploy`; secrets persist.)
  // The MailerLite group new subscribers join — drives the welcome automation.
  "vars": {
    "MAILERLITE_GROUP_ID": "189440171093001807"
  },
  // NOTE: MAILERLITE_API_KEY is a SECRET — add it in the dashboard
  // (Settings → Variables and Secrets → Add → type "Secret"). Never commit it.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Serve dist/404.html for unmatched paths (Astro emits it).
    "not_found_handling": "404-page"
  }
}
